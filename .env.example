# Copy to .env and fill in a key. Never commit .env.
# Provider: groq | gemini | auto (auto = Groq if its key is set, else Gemini)
LLM_PROVIDER=auto
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults: groq=openai/gpt-oss-120b, gemini=gemini-3.8-flash)
# LLM_MODEL=
MAX_AGENT_STEPS=8
